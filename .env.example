# Copy to .env and adjust. Every value is optional; defaults are shown.
# Real shell environment variables take priority over this file.

# Folder with knowledge documents (relative paths resolve from the project root).
FKA_DOCUMENTS_DIR=data/documents

# Maximum number of documents returned per question.
FKA_TOP_K=3

# Cosine similarity below this value is treated as "not relevant" (0.0 - 1.0).
FKA_MIN_SIMILARITY=0.10

# Chunking: soft maximum words per chunk, and sentences repeated between chunks.
FKA_CHUNK_MAX_WORDS=80
FKA_CHUNK_OVERLAP_SENTENCES=1

# ---------------------------------------------------------------------------
# Phase 2 placeholders (NOT used by Phase 1 code).
# Never commit a real key. .env is listed in .gitignore.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=
# OPENAI_API_KEY=
# DATABASE_URL=postgresql://user:password@localhost:5432/knowledge
